# Copia estas variables en tu terminal (o en iniciar.bat) para cambiar la configuración.
# Trazo no lee archivos .env por sí mismo; no guardes secretos aquí.

# Puerto HTTP/WebSocket
PORT=3080
# 0.0.0.0 = accesible desde la red local; 127.0.0.1 = solo este PC
HOST=0.0.0.0
# Carpeta donde se guardan las salas
DATA_DIR=data
# Retardo del guardado en disco (ms)
SAVE_DELAY_MS=1000
# Minutos que una sala sin participantes sigue abierta antes de cerrarse y borrarse
EMPTY_ROOM_TTL_MIN=2
# Cada cuánto se revisan las salas vacías (ms)
SWEEP_INTERVAL_MS=30000
# debug | info | warn | error | silent
LOG_LEVEL=info
